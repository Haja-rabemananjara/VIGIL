FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    curl wget file build-essential \
    libwebkit2gtk-4.1-dev \
    libxdo-dev libssl-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libfuse2 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.96.0
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ENV APPIMAGE_EXTRACT_AND_RUN=1
RUN npx tauri build --bundles appimage

RUN mkdir -p /output && \
    cp src-tauri/target/release/bundle/appimage/*.AppImage /output/client.AppImage

CMD ["true"]