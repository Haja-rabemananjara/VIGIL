  "query": "\n        SELECT t.id AS \"id!\", t.name AS \"name!\",\n               t.created_at AS \"created_at!\", tm.role AS \"role!\"\n        FROM teams t\n        JOIN team_members tm ON tm.team_id = t.id\n        WHERE t.id = $1\n          AND tm.user_id = $2\n          AND tm.status = 'active'\n        ",
