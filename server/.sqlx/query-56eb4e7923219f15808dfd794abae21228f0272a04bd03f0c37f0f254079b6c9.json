{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.id, a.team_id, a.actor_id,\n               u.display_name AS actor_name,\n               a.action, a.entity_type, a.entity_id, a.metadata, a.created_at\n        FROM audit_log a\n        LEFT JOIN users u ON u.id = a.actor_id\n        WHERE a.team_id = $1\n        ORDER BY a.created_at DESC\n        LIMIT $2 OFFSET $3\n        ",
