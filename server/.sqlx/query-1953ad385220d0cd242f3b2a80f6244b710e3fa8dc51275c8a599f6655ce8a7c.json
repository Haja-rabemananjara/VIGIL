{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, team_id, code, created_by, created_at,\n               expires_at, max_uses, uses\n        FROM invitations\n        WHERE code = $1\n          AND status = 'active'\n          AND (expires_at IS NULL OR expires_at > now())\n          AND (max_uses IS NULL OR uses < max_uses)\n        ",
