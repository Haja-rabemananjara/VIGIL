{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id AS \"user_id!\",\n               u.display_name AS \"display_name!\",\n               u.email AS \"email!\",\n               tm.role AS \"role!\",\n               u.avatar_seed,\n               tm.joined_at AS \"joined_at!\"\n        FROM team_members tm\n        JOIN users u ON u.id = tm.user_id\n        WHERE tm.team_id = $1\n          AND tm.status = 'active'\n        ORDER BY tm.joined_at\n        ",
