  "db_name": "PostgreSQL",
  "query": "\n        INSERT INTO incidents (id, team_id, title, body, severity, status, created_by, created_at, updated_at)\n        VALUES ($1, $2, $3, $4, $5, 'open', $6, now(), now())\n        RETURNING\n            id,\n            team_id,\n            title,\n            body,\n            severity,\n            status,\n            created_by,\n            created_at,\n            updated_at,\n            acknowledged_at,\n            escalated_at,\n            resolved_at,\n            (SELECT user_id FROM incident_assignments\n             WHERE incident_id = incidents.id AND status = 'active'\n             LIMIT 1) AS \"assignee_id?\"\n        ",
