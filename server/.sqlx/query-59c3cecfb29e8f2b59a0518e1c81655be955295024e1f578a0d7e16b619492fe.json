{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            re.id,\n            r.name AS rule_name,\n            r.reaction_type,\n            re.status,\n            re.error,\n            re.executed_at\n        FROM rule_executions re\n        JOIN rules r ON r.id = re.rule_id\n        WHERE r.team_id = $1\n        ORDER BY re.executed_at DESC\n        LIMIT $2\n        ",
