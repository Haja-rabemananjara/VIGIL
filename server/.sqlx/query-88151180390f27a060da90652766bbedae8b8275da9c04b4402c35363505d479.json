  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, incident_id, author_id, kind, content, created_at, edited_at\n        FROM timeline_entries\n        WHERE incident_id = $1\n          AND ($2::timestamptz IS NULL OR created_at < $2)\n        ORDER BY created_at ASC\n        LIMIT $3\n        ",
