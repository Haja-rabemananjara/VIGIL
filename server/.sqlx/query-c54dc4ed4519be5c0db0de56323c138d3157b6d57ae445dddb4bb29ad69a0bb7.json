{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            i.id,\n            i.team_id,\n            i.title,\n            i.body,\n            i.severity,\n            i.status,\n            i.created_by,\n            i.created_at,\n            i.updated_at,\n            i.acknowledged_at,\n            i.escalated_at,\n            i.resolved_at,\n            ia.user_id AS \"assignee_id?\"\n        FROM incidents i\n        LEFT JOIN incident_assignments ia\n            ON ia.incident_id = i.id AND ia.status = 'active'\n        WHERE i.id = $1\n        ",
