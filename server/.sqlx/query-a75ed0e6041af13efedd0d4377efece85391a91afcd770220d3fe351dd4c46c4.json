{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id,\n            team_id,\n            title,\n            body,\n            severity,\n            status,\n            created_by,\n            created_at,\n            updated_at,\n            acknowledged_at,\n            escalated_at,\n            resolved_at\n        FROM incidents\n        WHERE team_id = $1\n          AND ($2::text IS NULL OR status = $2)\n          AND ($3::text IS NULL OR severity = $3)\n        ORDER BY created_at DESC\n        ",
